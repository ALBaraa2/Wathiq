# Shared AI service integration config. Both Back-end/wathiq and AI read the
# same values — see AI/docs/PHASE0_DECISIONS.md §6. Not a secrets store: fill
# real values in each service's own untracked .env.

AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=
AI_WEBHOOK_SECRET=
AI_WEBHOOK_TIMEOUT_SECONDS=60
AI_WEBHOOK_MAX_RETRIES=3
