# AI service's own copy of the shared values — see ../.env.example and
# docs/PHASE0_DECISIONS.md §6.

AI_SERVICE_API_KEY=
AI_WEBHOOK_SECRET=
LARAVEL_CALLBACK_URL=http://localhost:8000/api/ai/callback

# Leave these blank to run on FakeLLMProvider/FakeEmbeddingProvider
# (deterministic, no network) — that's what tests use.

# DeepInfra — embeddings (Qwen3-Embedding-8B)
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1536

# OpenRouter — LLM (DeepSeek-V4-Pro)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=deepseek/deepseek-v4-pro
